TELEGRAM_API_ID=         # https://my.telegram.org
TELEGRAM_API_HASH=       # https://my.telegram.org
TELEGRAM_SESSION=        # Run `bun auth` to generate
PORT=3000                # MCP server port
# TELEGRAM_MOCK=true     # Enable mock mode (no real Telegram needed)
# TELEGRAM_MCP_CONFIG=bot-data/config.yml  # Config file path for write-tool restrictions
# LOG_LEVEL=info         # pino log level: trace|debug|info|warn|error|fatal

# Auth redirect URL base (used to build re-auth links when session expires)
# PUBLIC_BASE_URL=https://your-domain.com

# Comma-separated list of trusted proxy IPs/CIDRs (for X-Forwarded-Host/Proto)
# TRUSTED_PROXY_IPS=10.0.0.1,192.168.1.0/24

# KEEPALIVE_INTERVAL_MS=21600000  # Session keepalive interval in ms (default: 6h)

# Docker: path where session is saved inside the container (mounted volume)
# ENV_FILE=/app/bot-data/.env
