{
  "name": "mcp-telegram",
  "version": "0.1.0",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "auth": "bun run src/auth.ts",
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "dev:mock": "TELEGRAM_MOCK=true bun run src/index.ts",
    "test": "bun test --preload ./src/test-preload.ts",
    "check": "bun run lint && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check:structure": "bun run scripts/check-structure.ts",
    "knip": "knip",
    "audit": "bun run scripts/audit.ts",
    "docker:build": "docker build -t telegram-mcp .",
    "docker:run": "docker compose up"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "knip": "^6.29.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "express-rate-limit": "8.6.1",
    "fast-uri": "4.1.1",
    "hono": "4.12.32",
    "ip-address": "10.3.1",
    "path-to-regexp": "8.4.2",
    "qs": "6.15.3"
  },
  "knip": {
    "entry": [
      "src/index.ts",
      "src/auth.ts",
      "scripts/*.ts"
    ],
    "project": [
      "src/**/*.ts",
      "scripts/**/*.ts"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mtcute/bun": "^0.28.2",
    "@mtcute/dispatcher": "^0.28.2",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
